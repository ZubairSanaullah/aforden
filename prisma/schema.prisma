generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  DISPATCHER
  TECHNICIAN
  ACCOUNTANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_OPERATIONS
  PLATFORM_SECURITY
  PLATFORM_BILLING
}

enum PlatformAdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum JobTitleStatus {
  ACTIVE
  INACTIVE
}

enum SkillStatus {
  ACTIVE
  INACTIVE
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ServiceAreaStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TechnicianAvailabilityStatus {
  ACTIVE
  INACTIVE
}

enum TechnicianExceptionType {
  TIME_OFF
  VACATION
  SICK_LEAVE
  PERSONAL_LEAVE
  HOLIDAY
  TRAINING
  UNAVAILABLE
  OTHER
}

enum TechnicianAvailabilityExceptionStatus {
  ACTIVE
  CANCELLED
}

enum AssignmentWorkType {
  WORK
}

enum TechnicianAssignmentStatus {
  ASSIGNED
  CANCELLED
  COMPLETED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ServiceCatalogStatus {
  ACTIVE
  INACTIVE
}

enum WorkTypeStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderHistoryEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  DELETED
}

enum AssetStatus {
  OPERATIONAL
  DEGRADED
  OUT_OF_SERVICE
  IN_STORAGE
  DECOMMISSIONED
  RETIRED
}

enum AssetCategoryStatus {
  ACTIVE
  INACTIVE
}

enum AssetHistoryEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  LOCATION_TRANSFERRED
  OWNERSHIP_TRANSFERRED
  DECOMMISSIONED
  REACTIVATED
  RETIRED
}

enum ScheduleStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum DispatchStatus {
  PENDING_DISPATCH
  DISPATCHED
  ACKNOWLEDGED
}

enum ScheduleHistoryEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  DISPATCHED
  UNDISPATCHED
  UPDATED
}

enum TimeEntryType {
  TRAVEL
  ON_SITE
  BREAK
  ADMIN
}

enum TimeEntryStatus {
  ACTIVE
  COMPLETED
}

enum PartStatus {
  ACTIVE
  INACTIVE
}

enum PartUnitOfMeasure {
  EACH
  BOX
  PACK
  PAIR
  KIT
  FOOT
  METER
  LITER
  GAL
  LB
  KG
  ROLL
  SHEET
  SET
}

enum InventoryLocationType {
  WAREHOUSE
  VEHICLE
  TECHNICIAN_STOCK
  OTHER
}

enum InventoryLocationStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUMPTION
  RETURN
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum QuoteLineItemType {
  LABOR
  PART
  EXPENSE
  CUSTOM
}

enum QuoteDiscountType {
  PERCENTAGE
  FIXED
}

enum QuoteHistoryEventType {
  CREATED
  UPDATED
  LINE_ITEM_ADDED
  LINE_ITEM_UPDATED
  LINE_ITEM_REMOVED
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  DELETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum InvoiceLineItemType {
  LABOR
  PART
  EXPENSE
  CUSTOM
}

enum InvoiceDiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  BANK_TRANSFER
  ACH
  OTHER
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum InvoiceHistoryEventType {
  CREATED
  UPDATED
  LINE_ITEM_ADDED
  LINE_ITEM_UPDATED
  LINE_ITEM_REMOVED
  ISSUED
  PAYMENT_APPLIED
  PAYMENT_VOIDED
  OVERDUE_MARKED
  VOIDED
  DELETED
}

enum NotificationEventType {
  WORK_ORDER_CREATED
  WORK_ORDER_ASSIGNED
  WORK_ORDER_REASSIGNED
  WORK_ORDER_UNASSIGNED
  WORK_ORDER_STATUS_CHANGED
  WORK_ORDER_STARTED
  WORK_ORDER_PAUSED
  WORK_ORDER_RESUMED
  WORK_ORDER_COMPLETED
  WORK_ORDER_CANCELLED

  SCHEDULE_APPOINTMENT_SCHEDULED
  SCHEDULE_APPOINTMENT_RESCHEDULED
  SCHEDULE_DISPATCH_CHANGED
  SCHEDULE_APPOINTMENT_APPROACHING

  QUOTE_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  QUOTE_EXPIRED

  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  PAYMENT_FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  PARTIALLY_SENT
  FAILED
  SUPPRESSED
  CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  PENDING_RETRY
  EXHAUSTED
  SKIPPED
  SUPPRESSED
}

enum RecipientType {
  WORKSPACE_MEMBER
  CUSTOMER_CONTACT
  DIRECT_RECIPIENT
}

enum NotificationPreferenceScope {
  WORKSPACE
  MEMBER
  CUSTOMER
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  passwordHash  String?
  emailVerified DateTime?
  avatarUrl     String?
  status        UserStatus @default(PENDING)
  platformRole  PlatformRole?

  memberships                  WorkspaceMember[]
  accounts                     Account[]
  sessions                     Session[]
  passwordResets               PasswordResetToken[]
  sentInvitations              WorkspaceInvitation[]
  assetHistories               AssetHistory[]
  createdDeveloperApplications DeveloperApplication[] @relation("CreatedDeveloperApplications")
  platformAdminProfile         PlatformAdminProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([platformRole])
}

model PlatformAdminProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  status            PlatformAdminStatus @default(ACTIVE)
  lastActiveAt      DateTime?
  lastLoginAt       DateTime?
  stepUpConfirmedAt DateTime?
  metadata          Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastActiveAt])
}

model PlatformAuditLog {
  id            String       @id @default(cuid())
  actorUserId   String
  actorEmail    String
  actorRole     PlatformRole
  action        String       @db.VarChar(128)
  targetType    String       @db.VarChar(64)
  targetId      String       @db.VarChar(128)
  workspaceId   String?
  requestId     String       @db.VarChar(64)
  ipAddress     String       @db.VarChar(64)
  userAgent     String?      @db.VarChar(512)
  reason        String?      @db.Text
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([workspaceId, createdAt])
  @@index([requestId])
}

model Workspace {
  id                  String  @id @default(cuid())
  name                String
  slug                String  @unique
  logoUrl             String?
  timezone            String  @default("Asia/Karachi")
  defaultCurrencyCode String  @default("USD") @db.VarChar(3)

  memberships                   WorkspaceMember[]
  invitations                   WorkspaceInvitation[]
  organization                  Organization?
  employees                     Employee[]
  departments                   Department[]
  jobTitles                     JobTitle[]
  skills                        Skill[]
  serviceAreas                  ServiceArea[]
  customers                     Customer[]
  serviceCatalogs               ServiceCatalog[]
  workTypes                     WorkType[]
  workOrders                    WorkOrder[]
  workOrderHistories            WorkOrderHistory[]
  assets                        Asset[]
  assetCategories               AssetCategory[]
  assetHistories                AssetHistory[]
  scheduleAppointments          ScheduleAppointment[]
  scheduleAppointmentHistories  ScheduleAppointmentHistory[]
  technicianTimeEntries         TechnicianTimeEntry[]
  parts                         Part[]
  inventoryLocations            InventoryLocation[]
  inventoryBalances             InventoryBalance[]
  stockMovements                StockMovement[]
  workOrderParts                WorkOrderPart[]
  quotes                        Quote[]
  quoteLineItems                QuoteLineItem[]
  quoteHistories                QuoteHistory[]
  invoices                      Invoice[]
  invoiceLineItems              InvoiceLineItem[]
  payments                      Payment[]
  invoiceHistories              InvoiceHistory[]
  notificationOutboxes          NotificationOutbox[]
  notifications                 Notification[]
  notificationDeliveries        NotificationDelivery[]
  notificationTemplates         NotificationTemplate[]
  notificationPreferences       NotificationPreference[]
  notificationLogs              NotificationLog[]
  inAppNotificationFeeds        InAppNotificationFeed[]
  subscriptions                 Subscription[]
  subscriptionInvoices          SubscriptionInvoice[]
  subscriptionPayments          SubscriptionPayment[]
  platformBillingAccount        PlatformBillingAccount?
  workspaceEntitlementOverrides WorkspaceEntitlementOverride[]
  automationRules               AutomationRule[]
  automationTriggers            AutomationTrigger[]
  automationConditionGroups     AutomationConditionGroup[]
  automationConditions          AutomationCondition[]
  automationActions             AutomationAction[]
  automationExecutions          AutomationExecution[]
  automationExecutionSteps      AutomationExecutionStep[]
  automationScheduleJobs        AutomationScheduleJob[]
  integrationConnections        IntegrationConnection[]
  integrationWebhooks           IntegrationWebhook[]
  integrationExecutions         IntegrationExecution[]
  integrationWebhookEvents      IntegrationWebhookEvent[]
  activeExclusiveCapabilities   WorkspaceActiveExclusiveCapability[]
  integrationSetting            WorkspaceIntegrationSetting?
  developerApplications         DeveloperApplication[]
  apiIdempotencyRecords         ApiIdempotencyRecord[]
  apiRequestLogs                ApiRequestLog[]
  webhookEndpoints              WebhookEndpoint[]
  webhookDeliveries             WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Organization {
  id          String @id @default(cuid())
  workspaceId String @unique

  businessName String
  legalName    String?
  logoUrl      String?
  email        String?
  phone        String?
  website      String?
  description  String? @db.Text

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  taxId              String?
  registrationNumber String?

  status OrganizationStatus @default(ACTIVE)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model WorkspaceMember {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole   @default(TECHNICIAN)
  status      MembershipStatus @default(INVITED)

  user                         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace                    Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employee                     Employee?
  workOrderHistories           WorkOrderHistory[]
  dispatchedAppointments       ScheduleAppointment[]        @relation("DispatchedByMember")
  undispatchedAppointments     ScheduleAppointment[]        @relation("UndispatchedByMember")
  scheduleAppointmentHistories ScheduleAppointmentHistory[]
  createdTechnicianTimeEntries TechnicianTimeEntry[]
  stockMovements               StockMovement[]
  workOrderParts               WorkOrderPart[]
  recordedPayments             Payment[]                    @relation("PaymentRecordedBy")
  voidedPayments               Payment[]                    @relation("PaymentVoidedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Employee {
  id                String  @id @default(cuid())
  workspaceId       String
  workspaceMemberId String  @unique
  departmentId      String?
  jobTitleId        String?

  employeeNumber String?
  displayName    String?
  phone          String?
  hireDate       DateTime?
  status         EmployeeStatus @default(ACTIVE)
  notes          String?        @db.Text

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceMember   WorkspaceMember    @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle          JobTitle?          @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  technicianProfile TechnicianProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, employeeNumber])
  @@index([workspaceId])
  @@index([workspaceMemberId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([status])
}

model Department {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?          @db.Text
  status      DepartmentStatus @default(ACTIVE)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([status])
}

model JobTitle {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  description String?        @db.Text
  status      JobTitleStatus @default(ACTIVE)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([status])
}

model TechnicianProfile {
  id         String @id @default(cuid())
  employeeId String @unique

  licenseNumber    String?
  yearsExperience  Int?
  emergencyContact String?
  notes            String? @db.Text

  employee                         Employee                          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  technicianSkills                 TechnicianSkill[]
  technicianServiceAreas           TechnicianServiceArea[]
  technicianAvailabilities         TechnicianAvailability[]
  technicianAvailabilityExceptions TechnicianAvailabilityException[]
  technicianAssignments            TechnicianAssignment[]
  workOrders                       WorkOrder[]
  scheduleAppointments             ScheduleAppointment[]
  technicianTimeEntries            TechnicianTimeEntry[]
  inventoryLocations               InventoryLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Skill {
  id          String @id @default(cuid())
  workspaceId String

  name        String
  description String?     @db.Text
  status      SkillStatus @default(ACTIVE)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  technicianSkills TechnicianSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([status])
}

model TechnicianSkill {
  id                  String @id @default(cuid())
  technicianProfileId String
  skillId             String

  proficiency     SkillProficiency @default(INTERMEDIATE)
  yearsExperience Int?
  notes           String?          @db.Text

  technicianProfile TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([technicianProfileId, skillId])
  @@index([technicianProfileId])
  @@index([skillId])
}

model ServiceArea {
  id          String @id @default(cuid())
  workspaceId String

  name        String
  description String?           @db.Text
  status      ServiceAreaStatus @default(ACTIVE)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  technicianServiceAreas TechnicianServiceArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([status])
}

model TechnicianServiceArea {
  id                  String @id @default(cuid())
  technicianProfileId String
  serviceAreaId       String

  notes String? @db.Text

  technicianProfile TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)
  serviceArea       ServiceArea       @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([technicianProfileId, serviceAreaId])
  @@index([technicianProfileId])
  @@index([serviceAreaId])
}

model TechnicianAvailability {
  id                  String                       @id @default(cuid())
  technicianProfileId String
  dayOfWeek           AvailabilityDay
  startTime           String
  endTime             String
  status              TechnicianAvailabilityStatus @default(ACTIVE)
  notes               String?                      @db.Text

  technicianProfile TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([technicianProfileId, dayOfWeek, startTime, endTime])
  @@index([technicianProfileId])
  @@index([dayOfWeek])
  @@index([status])
}

model TechnicianAvailabilityException {
  id                  String @id @default(cuid())
  technicianProfileId String

  type   TechnicianExceptionType
  status TechnicianAvailabilityExceptionStatus @default(ACTIVE)

  title    String
  startsAt DateTime
  endsAt   DateTime
  isAllDay Boolean  @default(false)

  notes String? @db.Text

  technicianProfile TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianProfileId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([status])
  @@index([type])
}

model TechnicianAssignment {
  id                  String @id @default(cuid())
  technicianProfileId String

  workType        AssignmentWorkType @default(WORK)
  workReferenceId String

  status TechnicianAssignmentStatus @default(ASSIGNED)

  startsAt DateTime
  endsAt   DateTime

  notes String? @db.Text

  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  technicianProfile TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianProfileId])
  @@index([workReferenceId])
  @@index([workType])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([completedAt])
  @@index([cancelledAt])
}

model WorkspaceInvitation {
  id          String         @id @default(cuid())
  workspaceId String
  /// Normalized (lowercased) email address of the invited person.
  email       String
  invitedById String
  role        MembershipRole @default(TECHNICIAN)
  /// SHA-256 hex hash of the raw invitation token. Never the raw token.
  tokenHash   String         @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([email])
  @@index([workspaceId, email])
  @@index([expiresAt])
}

model Customer {
  id             String         @id @default(cuid())
  workspaceId    String
  customerNumber String?
  name           String
  email          String?
  phone          String?
  website        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?        @db.Text

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contacts   CustomerContact[]
  locations  ServiceLocation[]
  workOrders WorkOrder[]
  assets     Asset[]
  quotes     Quote[]
  invoices   Invoice[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, customerNumber])
  @@index([workspaceId])
  @@index([status])
  @@index([name])
  @@index([workspaceId, status])
}

model CustomerContact {
  id         String @id @default(cuid())
  customerId String

  firstName   String
  lastName    String
  title       String?
  email       String?
  phone       String?
  mobilePhone String?
  isPrimary   Boolean @default(false)
  notes       String? @db.Text

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, isPrimary])
}

model ServiceLocation {
  id         String @id @default(cuid())
  customerId String

  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  latitude     Decimal?
  longitude    Decimal?
  notes        String?  @db.Text
  isPrimary    Boolean  @default(false)

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]
  assets     Asset[]
  quotes     Quote[]
  invoices   Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, isPrimary])
}

model ServiceCatalog {
  id          String               @id @default(cuid())
  workspaceId String
  name        String
  description String?              @db.Text
  status      ServiceCatalogStatus @default(ACTIVE)
  sortOrder   Int                  @default(0)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workTypes WorkType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, status])
  @@index([sortOrder])
}

model WorkType {
  id                String         @id @default(cuid())
  workspaceId       String
  catalogId         String
  name              String
  code              String?
  description       String?        @db.Text
  estimatedDuration Int?
  status            WorkTypeStatus @default(ACTIVE)
  sortOrder         Int            @default(0)

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  catalog          ServiceCatalog    @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  workOrders       WorkOrder[]
  quoteLineItems   QuoteLineItem[]
  invoiceLineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([catalogId, name])
  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([catalogId])
  @@index([status])
  @@index([workspaceId, status])
  @@index([sortOrder])
}

model WorkOrder {
  id              String @id @default(cuid())
  workspaceId     String
  workOrderNumber String

  customerId           String
  locationId           String
  workTypeId           String
  assignedTechnicianId String?
  assetId              String?
  sourceQuoteId        String?

  workTypeName      String
  workTypeCode      String?
  estimatedDuration Int?

  status   WorkOrderStatus   @default(OPEN)
  priority WorkOrderPriority @default(MEDIUM)

  title              String
  description        String? @db.Text
  internalNotes      String? @db.Text
  holdReason         String? @db.Text
  cancellationReason String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

