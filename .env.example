# Primary Database (PostgreSQL via Supabase or Direct)
DATABASE_URL="postgresql://postgres.aldjaguujwgcrricddtm:LoginAfordenZ1@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.aldjaguujwgcrricddtm:LoginAfordenZ1@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Paddle Billing Provider (Phase 1.23)
PADDLE_API_KEY="paddlesecret_..."
