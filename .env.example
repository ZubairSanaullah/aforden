# ==============================================================================
# Aforden Platform — Environment Configuration Template
# ==============================================================================

# Application & Auth (Production Canonical Origin: https://aforden.aformix.com)
NEXT_PUBLIC_APP_URL="https://aforden.aformix.com"
AUTH_URL="https://aforden.aformix.com"
AUTH_TRUST_HOST="true" # Required for Auth.js v5 behind Vercel edge reverse proxy
AUTH_SECRET="replace-with-high-entropy-secret"

# Primary Database (PostgreSQL via Supabase or Direct)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Paddle Billing Provider (Phase 1.23)
PADDLE_API_KEY="paddlesecret_..."
PADDLE_WEBHOOK_SECRET="paddlenotification_..."
PADDLE_ENVIRONMENT="sandbox" # "sandbox" | "production"

# Stripe Billing Provider (Legacy / Fallback)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Active Billing Provider ("PADDLE" | "STRIPE" | "MOCK")
BILLING_PROVIDER="PADDLE"

# Transactional Email (Brevo / Resend)
BREVO_API_KEY="xkeysib-..."
BREVO_WEBHOOK_SECRET="whsec_brevo_..."
RESEND_API_KEY="re_..."
EMAIL_PROVIDER="BREVO" # "BREVO" | "RESEND"
EMAIL_FROM="notifications@aforden.com"
EMAIL_FROM_ADDRESS="notifications@aforden.com"
EMAIL_FROM_NAME="Aforden Platform"

# AWS S3 Storage
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET="aforden-storage"

# Security & Secrets Management
INTEGRATION_KEY_ENCRYPTION_SECRET="replace-with-32-byte-hex-encryption-key"

# Administrative & Cron Triggers
CRON_SECRET="replace-with-secure-bearer-secret"

# Third-Party Integration Adapters (Phase 1.17)
# Twilio (SMS Communications)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_FROM_PHONE_NUMBER="+15551234567"

# QuickBooks Online (Accounting Integration)
QUICKBOOKS_CLIENT_ID="replace-with-quickbooks-client-id"
QUICKBOOKS_CLIENT_SECRET="replace-with-quickbooks-client-secret"
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN="replace-with-quickbooks-verifier-token"

# Google Calendar (Scheduling Integration)
GOOGLE_CLIENT_ID="replace-with-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

