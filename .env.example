# ==============================================================================
# Aforden Platform — Environment Configuration Template
# ==============================================================================

# Application & Auth
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-high-entropy-secret"

# Primary Database (PostgreSQL via Supabase or Direct)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Paddle Billing Provider (Phase 1.23)
PADDLE_API_KEY="paddlesecret_..."
PADDLE_WEBHOOK_SECRET="paddlenotification_..."
PADDLE_ENVIRONMENT="sandbox" # "sandbox" | "production"

# Stripe Billing Provider (Legacy / Fallback)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Active Billing Provider ("PADDLE" | "STRIPE" | "MOCK")
BILLING_PROVIDER="PADDLE"

# Transactional Email (Brevo / Resend)
BREVO_API_KEY="xkeysib-..."
RESEND_API_KEY="re_..."
EMAIL_PROVIDER="BREVO" # "BREVO" | "RESEND"
EMAIL_FROM="notifications@aforden.com"
EMAIL_FROM_ADDRESS="notifications@aforden.com"
EMAIL_FROM_NAME="Aforden Platform"

# AWS S3 Storage
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET="aforden-storage"

# Administrative & Cron Triggers
CRON_SECRET="replace-with-secure-bearer-secret"
